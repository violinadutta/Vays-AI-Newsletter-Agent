# =============================================================================
#  AI Newsletter Generation & Distribution Platform — environment template
#
#  SETUP:  Copy-Item .env.example .env     then fill in the values below.
#  Every variable is documented. REQUIRED ones have no working default —
#  the app refuses to start without them and tells you exactly which are missing.
#
#  NEVER commit .env. It is git-ignored. This file (.env.example) is committed
#  and must only ever contain placeholders.
# =============================================================================


# ─────────────────────────────────────────────────────────────────────────────
#  APPLICATION
# ─────────────────────────────────────────────────────────────────────────────

# local | dev | staging | prod
#   local   -> mock LLM + console email. No network and no API key needed.
#   dev     -> real Groq LLM + console or sandbox email.
#   prod    -> real Groq LLM + a real mail provider.
APP_ENV=dev

# REQUIRED. Signs session tokens. Minimum 32 characters.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO


# ─────────────────────────────────────────────────────────────────────────────
#  LLM  —  ### READ THIS SECTION IF YOU ARE TAKING OVER THIS PROJECT ###
#
#  The application NEVER runs a model locally. All inference is remote.
#
#  To point this app at YOUR OWN LLM, change these lines and nothing else:
#      LLM_PROVIDER=hosted
#      LLM_BASE_URL=https://your-llm-host
#      LLM_API_KEY=your-key
#  Any server speaking the OpenAI /v1/chat/completions protocol works —
#  vLLM, TGI, Ollama, LM Studio, or a commercial endpoint.
#  No code changes. See docs/SWAP_THE_LLM.md.
# ─────────────────────────────────────────────────────────────────────────────

# groq   -> open-weight models on Groq's API           (default, D-21)
# hosted -> any other OpenAI-compatible endpoint       (the handover path)
# mock   -> canned JSON fixtures; no network, no GPU   (offline dev + CI)
LLM_PROVIDER=groq

# REQUIRED for groq. Create a free key at https://console.groq.com/keys
# (no credit card). LLM_API_KEY also works if you prefer the generic name.
GROQ_API_KEY=

# Base URL WITHOUT the trailing /v1 — the client appends it.
# Leave as-is for Groq; change it only to point at a different endpoint.
LLM_BASE_URL=https://api.groq.com/openai

# Groq serves ONLY open-source models, so any choice here satisfies the
# open-source-LLM requirement.
#
# `strict` schema enforcement — which makes malformed JSON impossible rather
# than merely unlikely — is available only on these:
#     openai/gpt-oss-120b            <- default: largest, best quality
#     openai/gpt-oss-20b             <- faster, lighter on the token quota
#     moonshotai/kimi-k2-instruct-0905
#
# NOTE: "openai/gpt-oss-*" is Apache 2.0 OPEN-WEIGHT despite the vendor prefix
# in its name. It is not a proprietary OpenAI model.
#
# Any other Groq model (llama-3.3-70b-versatile, qwen-*, gemma2-*) also works,
# but without hard schema enforcement — the app falls back to a repair-retry.
LLM_MODEL=openai/gpt-oss-120b

LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# Circuit breaker: stop hammering a dead endpoint (TRD §7.2).
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_RESET_S=60


# ─────────────────────────────────────────────────────────────────────────────
#  EMAIL
# ─────────────────────────────────────────────────────────────────────────────

# brevo   -> Brevo transactional API (300/day free tier)
# smtp    -> any SMTP server, incl. Mailtrap sandbox
# console -> writes .eml files to data/outbox/ and sends NOTHING (safe default
#            for development — you cannot accidentally email a real customer)
EMAIL_PROVIDER=console

EMAIL_SENDER_NAME=Vays Infotech
EMAIL_SENDER_ADDRESS=newsletter@example.com
EMAIL_REPLY_TO=marketing@example.com

EMAIL_BATCH_SIZE=50
EMAIL_BATCH_DELAY_S=2
EMAIL_MAX_RETRIES=3

# Required when EMAIL_PROVIDER=brevo.
# Create a key at https://app.brevo.com/settings/keys/api — 300 emails/day free.
BREVO_API_KEY=

# Required when EMAIL_PROVIDER=smtp.
# For Gmail: host smtp.gmail.com, port 587, TLS true, username = the full
# address, and SMTP_PASSWORD = a 16-character APP PASSWORD, not the account
# password. App passwords need 2-Step Verification on, then are created at
# https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true


# ─────────────────────────────────────────────────────────────────────────────
#  SCRAPER
# ─────────────────────────────────────────────────────────────────────────────
SCRAPER_TIMEOUT_S=20
SCRAPER_MAX_RETRIES=2
SCRAPER_USER_AGENT=VaysNewsletterBot/1.0 (+https://vaysinfotech.com/bot)
SCRAPER_RESPECT_ROBOTS=true
SCRAPER_MAX_CONCURRENT=4

# Below this word count, the extractor falls through to the next tier.
SCRAPER_MIN_WORD_COUNT=200

# Input token budget per article before smart truncation kicks in.
# Kept modest for Groq's free tier, which is generous on requests (~30/min) and
# tight on TOKENS (~8-12k/min). Raise it if you move to a paid tier.
SCRAPER_MAX_INPUT_TOKENS=3000


# ─────────────────────────────────────────────────────────────────────────────
#  DATABASE
#  SQLite needs no server. The file IS the backup — copy it to back up.
#  Postgres migration is a URL change only:
#      DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/app.db


# ─────────────────────────────────────────────────────────────────────────────
#  BRANDING  —  appears in every email that goes out
# ─────────────────────────────────────────────────────────────────────────────
BRAND_NAME=Vays Infotech
BRAND_PRIMARY_COLOR=#54ACBF

# A LOCAL FILE is embedded into the email as an inline CID attachment, which is
# the only approach that renders in both Gmail and Outlook — both strip `data:`
# URIs, and a filesystem path in <img src> resolves to nothing.
# An http(s):// URL is passed through unchanged, so a hosted logo needs no code
# change. A missing file degrades to a text fallback and never blocks a send.
BRAND_LOGO_PATH=assets/image001.png
BRAND_WEBSITE=https://vaysinfotech.com

# REQUIRED BY LAW in most jurisdictions (CAN-SPAM / GDPR). A real postal address
# must appear in every marketing email. The renderer will refuse to build an
# email without it.
BRAND_ADDRESS=

UNSUBSCRIBE_BASE_URL=https://vaysinfotech.com/unsubscribe

# ═════════════════════════════════════════════════════════════════════════════
#  AUTOMATION AGENT
#  Discovers new blog posts, drafts newsletters, and sends them once a human
#  has approved them. Ships OFF — the manual workflow is unaffected either way.
#  Every value below is also editable in Settings → Agent without a restart.
# ═════════════════════════════════════════════════════════════════════════════
AGENT_ENABLED=false

# The site watched for new posts. WordPress REST API first, RSS feed as fallback.
AGENT_BLOG_URL=https://vaysinfotech.com
AGENT_DISCOVERY_INTERVAL_HOURS=6

# Posts pulled into the pipeline per run. Low on purpose: Groq's free tier is
# tight on TOKENS per minute (~8-12k) and one article costs about 3,450.
AGENT_MAX_POSTS_PER_RUN=3
AGENT_MAX_ATTEMPTS=3

# THIS is what limits how often customers receive mail, not the settings above.
# The agent refuses to start new work while a campaign is still unsent, so the
# pipeline — not the discovery cadence — bounds the frequency.
#
# A per-run cap alone is NOT enough and this was learned the hard way: with
# discovery every 6 hours, a backlog of blog posts produced a queue of campaigns
# that all became due on the same day, and nine newsletters went out within two
# minutes. Keep this at 1 for the one-per-month cadence.
AGENT_MAX_IN_FLIGHT=1

# When approved campaigns are sent.
#   monthly = the Nth chosen weekday of each month (the Vays cadence)
#   daily   = every day at AGENT_SEND_TIME, mainly useful for testing
# Defaults below read as: the 3rd Wednesday of each month at 11:00 IST.
# A campaign approved after that slot waits for the next month's.
AGENT_SEND_SCHEDULE=monthly
AGENT_SEND_WEEKDAY=wednesday
AGENT_SEND_WEEK_OF_MONTH=3
AGENT_SEND_TIME=11:00
AGENT_TIMEZONE=Asia/Kolkata

# Where the approval request goes. REQUIRED before the agent will run —
# generating drafts nobody is asked to approve just piles up work silently.
AGENT_APPROVAL_EMAIL=
AGENT_APPROVAL_TOKEN_TTL_HOURS=72

# Folder scanned for the recipient list; the newest .csv file wins.
AGENT_RECIPIENTS_DIR=data/recipients

# Where approvers reach this app FROM THEIR OWN MACHINE. The default only works
# if the approval email is opened on this computer. For anyone else, use a host
# or IP reachable from their network, e.g. http://192.168.1.40:8501
AGENT_APP_BASE_URL=auto

# ═════════════════════════════════════════════════════════════════════════════
#  PUBLIC ACCESS — the one switch between development and production
# ═════════════════════════════════════════════════════════════════════════════
# The port the dashboard serves on.
APP_PORT=8501

# Reserved ngrok domain, e.g. vays-newsletter.ngrok-free.app. Leave empty for a
# temporary address. See docs/PUBLIC_ACCESS.md.
NGROK_DOMAIN=
